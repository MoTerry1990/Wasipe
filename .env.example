# =====================================================================
# Wasipe — variables de entorno
#
# Copia este archivo a `.env` y completa los valores. `.env` está en
# .gitignore y NUNCA debe subirse al repositorio.
#
# Ninguna clave real va acá dentro. Solo el nombre y para qué sirve.
# =====================================================================


# ---------------------------------------------------------------------
# BASE DE DATOS — obligatoria
# ---------------------------------------------------------------------
# Cadena de conexión de Postgres. Hoy Neon; con la migración, Supabase.
# En Netlify también se aceptan NETLIFY_DATABASE_URL o NETLIFY_DB_URL.
DATABASE_URL=postgresql://usuario:contraseña@host/base?sslmode=require


# ---------------------------------------------------------------------
# SESIÓN
# ---------------------------------------------------------------------
# Secreto para firmar los JWT de sesión. Generar con:
#     openssl rand -base64 48
# Si se deja vacío, la aplicación genera uno y lo guarda en la tabla
# `config`. Funciona, pero conviene fijarlo aquí para poder rotarlo.
JWT_SECRET=


# ---------------------------------------------------------------------
# FOTOS — Cloudinary
#
# SIN ESTAS TRES VARIABLES NO SE PUEDE PUBLICAR: se exigen 3 fotos por
# aviso. El plan gratuito alcanza de sobra. Se sacan del panel de
# cloudinary.com después de registrarse.
#
# CLOUDINARY_API_SECRET jamás llega al navegador: solo se usa para
# firmar las subidas en el servidor.
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---------------------------------------------------------------------
# CORREO — Resend
#
# Mientras esté vacía, la verificación de correo queda DESACTIVADA a
# propósito: el token se generaría pero nunca llegaría, y el usuario
# quedaría sin poder publicar ni desbloquearse.
# Al configurarla, la exigencia se activa sola.
# ---------------------------------------------------------------------
RESEND_API_KEY=


# ---------------------------------------------------------------------
# PAGOS — Culqi (Perú: tarjetas y Yape)
# ---------------------------------------------------------------------
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
# SITIO
# ---------------------------------------------------------------------
# URL pública. La usa el sitemap y los enlaces de los correos.
URL_SITIO=https://wasipe.netlify.app

# La misma URL, pero visible desde el navegador: con ella se arman las
# etiquetas Open Graph, el sitemap y las URL canónicas de Next.
# En Vercel se configura en Settings → Environment Variables.
# Es pública a propósito; no es un secreto.
NEXT_PUBLIC_URL_SITIO=https://wasipe.vercel.app


# ---------------------------------------------------------------------
# WASI AI — asistente de avisos
#
# Wasipe no está atado a ninguna empresa de IA. `IA_PROVEEDOR` elige el
# adaptador de lib/ia/proveedores/. Valores válidos hoy:
#
#     anthropic   (por defecto)
#     ninguno     apaga Wasi AI a propósito
#
# Si se deja vacío o falta la clave del proveedor, el asistente aparece
# apagado y con su explicación. Publicar a mano sigue funcionando igual.
#
# NINGUNA de estas variables lleva el prefijo NEXT_PUBLIC_: las claves
# se leen solo en el servidor y jamás llegan al navegador.
# ---------------------------------------------------------------------
IA_PROVEEDOR=anthropic

# Clave del proveedor Anthropic. Se saca de console.anthropic.com.
ANTHROPIC_API_KEY=

# Modelo a usar. Vacío = el que trae el adaptador por defecto.
IA_MODELO=


# ---------------------------------------------------------------------
# WASI AI — mejora de fotos y amoblamiento virtual
#
# Se elige aparte del proveedor de texto: casi nunca es la misma empresa.
# Valores válidos de IA_PROVEEDOR_IMAGEN:
#
#     http        cualquier proveedor con endpoint HTTP (ver lib/ia/
#                 proveedores/imagen-http.ts para el contrato)
#     ninguno     apagado (por defecto)
#
# Con esto apagado, las fotos se publican tal como se subieron y el
# editor aparece deshabilitado con su explicación.
# ---------------------------------------------------------------------
IA_PROVEEDOR_IMAGEN=ninguno

# Endpoint del proveedor de imagen y su clave.
IA_IMAGEN_URL=
IA_IMAGEN_CLAVE=
IA_IMAGEN_MODELO=

# Qué operaciones sabe hacer, separadas por coma. Vacío = todas.
# lighting,white_balance,perspective,upscale,staging,style,wall_color,declutter
IA_IMAGEN_OPERACIONES=


# ---------------------------------------------------------------------
# WASI AI — video automático del aviso
#
# El mismo adaptador `http` sirve para tres cosas: una API externa de
# render, un servidor propio con Remotion, o una máquina nuestra con
# ffmpeg detrás de un proceso web. El contrato está documentado en
# lib/ia/proveedores/video-http.ts.
#
#     http        cualquiera de los tres
#     ninguno     apagado (por defecto)
#
# Los archivos van a una cubeta PRIVADA y se entregan con enlace firmado
# de 5 minutos: no hay URL pública de un video que reenviar.
# ---------------------------------------------------------------------
IA_PROVEEDOR_VIDEO=ninguno

IA_VIDEO_URL=
IA_VIDEO_CLAVE=

# Qué sabe hacer, separados por coma. Vacío = todo.
# vertical,square,horizontal  ·  modern,premium,minimal,reel
IA_VIDEO_FORMATOS=
IA_VIDEO_PLANTILLAS=


# ---------------------------------------------------------------------
# OBSERVABILIDAD
# ---------------------------------------------------------------------
SENTRY_DSN=


# =====================================================================
# PENDIENTES PARA LA MIGRACIÓN (todavía sin usar en el código)
# =====================================================================

# --- Supabase --- (ver el bloque del final para SUPABASE_DB_URL)
# La ANON_KEY es pública y puede ir al navegador: RLS la protege.
# La SERVICE_ROLE_KEY se salta RLS por completo — NUNCA exponerla en el
# cliente ni prefijarla con NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapas (detrás de una abstracción de proveedor) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
# o
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Pasarelas alternativas ---
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=

# --- Comprobantes electrónicos SUNAT ---
NUBEFACT_TOKEN=
NUBEFACT_URL=


# =====================================================================
# SUPABASE — Sprint 3 en adelante
# =====================================================================

# Cadena de conexión directa a Postgres. La usa el script de siembra y
# el CLI de Supabase. Se saca de:
#   Project Settings → Database → Connection string → URI
# Contiene la contraseña de la base: NUNCA se sube al repositorio y
# nunca lleva el prefijo NEXT_PUBLIC_.
SUPABASE_DB_URL=
